type Product { id: ID! name: String! slug: String! shortDescription: String! description: String! category: String! imageUrl: String featured: Boolean! status: String! displayOrder: Int! features: [String!]! packages: [Package!]! }
type Package { id: ID! productId: ID! name: String! description: String! price: String currency: String! billingFrequency: String! customPrice: Boolean! active: Boolean! featured: Boolean! displayOrder: Int! userLimit: String roomLimit: String productLimit: String supportLevel: String features: [String!]! }
type Service { id: ID! name: String! slug: String! shortDescription: String! description: String! imageUrl: String category: String! priceType: String! startingPrice: String currency: String! status: String! displayOrder: Int! }
type Inquiry { id: ID! referenceNumber: String! fullName: String! email: String! phone: String company: String subject: String! productId: ID message: String! status: String! assignedUserId: ID notes: String createdAt: String! }
type DemoRequest { id: ID! referenceNumber: String! fullName: String! companyName: String! email: String! phone: String! productId: ID! preferredDate: String preferredTime: String businessType: String additionalInformation: String status: String! assignedUserId: ID notes: String createdAt: String! }
type CompanySetting { key: String! value: String! }
type Dashboard { products: Int! packages: Int! services: Int! newInquiries: Int! pendingDemos: Int! recentInquiries: [Inquiry!]! recentDemos: [DemoRequest!]! }
type ProductPage { items: [Product!]! totalItems: Int! totalPages: Int! }
type PackagePage { items: [Package!]! totalItems: Int! totalPages: Int! }
type ServicePage { items: [Service!]! totalItems: Int! totalPages: Int! }
type InquiryPage { items: [Inquiry!]! totalItems: Int! totalPages: Int! }
type DemoPage { items: [DemoRequest!]! totalItems: Int! totalPages: Int! }
type AdminUserPage { items: [AdminAccount!]! totalItems: Int! totalPages: Int! }
type AuditPage { items: [AuditEntry!]! totalItems: Int! totalPages: Int! }
type AdminAccount { id: ID! email: String! role: String! active: Boolean! }
type AuditEntry { id: ID! actor: String! action: String! entityId: ID createdAt: String! }
input ProductInput { name: String! slug: String! shortDescription: String! description: String! category: String! imageUrl: String featured: Boolean displayOrder: Int features: [String!]! }
input PackageInput { productId: ID! name: String! description: String! price: String currency: String! billingFrequency: String! customPrice: Boolean! active: Boolean featured: Boolean displayOrder: Int userLimit: String roomLimit: String productLimit: String supportLevel: String features: [String!]! }
input ServiceInput { name: String! slug: String! shortDescription: String! description: String! imageUrl: String category: String priceType: String startingPrice: String currency: String displayOrder: Int }
input InquiryInput { fullName: String! email: String! phone: String company: String subject: String! productId: ID message: String! consent: Boolean! website: String }
input QuotationInput { fullName: String! email: String! phone: String company: String productId: ID message: String! consent: Boolean! website: String }
input DemoInput { fullName: String! companyName: String! email: String! phone: String! productId: ID! preferredDate: String preferredTime: String businessType: String additionalInformation: String consent: Boolean! website: String }
type Query { products: [Product!]! productBySlug(slug: String!): Product featuredProducts: [Product!]! services: [Service!]! serviceBySlug(slug: String!): Service pricingPackages(productSlug: String!): [Package!]! featuredPricingPackages: [Package!]! companySettings: [CompanySetting!]! adminDashboard: Dashboard! adminProducts: [Product!]! adminProductsPage(page: Int!, size: Int!, status: String, search: String, sort: String): ProductPage! adminProduct(id: ID!): Product adminPricingPackages: [Package!]! adminPricingPackagesPage(page: Int!, size: Int!, productId: ID, active: Boolean, search: String, sort: String): PackagePage! adminServices: [Service!]! adminServicesPage(page: Int!, size: Int!, status: String, search: String, sort: String): ServicePage! adminService(id: ID!): Service adminInquiries: [Inquiry!]! adminInquiry(id: ID!): Inquiry adminDemoRequests: [DemoRequest!]! adminDemoRequest(id: ID!): DemoRequest adminInquiriesPage(page: Int!, size: Int!, status: String, search: String, sort: String): InquiryPage! adminDemoRequestsPage(page: Int!, size: Int!, status: String, search: String, sort: String): DemoPage! adminCompanySettings: [CompanySetting!]! adminUsers: [AdminAccount!]! adminUsersPage(page: Int!, size: Int!, role: String, active: Boolean, search: String, sort: String): AdminUserPage! assignableUsers: [AdminAccount!]! adminAuditLogs(limit: Int): [AuditEntry!]! adminAuditLogsPage(page: Int!, size: Int!, search: String, sort: String): AuditPage! }
type Mutation { submitInquiry(input: InquiryInput!): Inquiry! requestDemo(input: DemoInput!): DemoRequest! requestQuotation(input: QuotationInput!): Inquiry! saveProduct(id: ID, input: ProductInput!): Product! setProductStatus(id: ID!, status: String!): Product! savePackage(id: ID, input: PackageInput!): Package! setPackageActive(id: ID!, active: Boolean!): Package! saveService(id: ID, input: ServiceInput!): Service! setServiceStatus(id: ID!, status: String!): Service! updateInquiry(id: ID!, status: String!, notes: String): Inquiry! assignInquiry(id: ID!, userId: ID): Inquiry! addInquiryNote(id: ID!, note: String!): Inquiry! updateDemo(id: ID!, status: String!, notes: String): DemoRequest! assignDemoRequest(id: ID!, userId: ID): DemoRequest! addDemoRequestNote(id: ID!, note: String!): DemoRequest! updateSetting(key: String!, value: String!): CompanySetting! createAdminUser(email: String!, password: String!, role: String!): AdminAccount! updateAdminUser(id: ID!, role: String!, active: Boolean!): AdminAccount! resetAdminPassword(id: ID!, password: String!): AdminAccount! }
